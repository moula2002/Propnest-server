# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/real_estate_db?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/real_estate_test_db?schema=public

# Server
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_ACCESS_SECRET=super_secret_access_jwt_key_at_least_32_characters_long_for_security_1234
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_characters_long_for_security_5678
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Clients
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Storage Provider (local | cloudinary | s3)
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIRECTORY=./uploads

# Optional Cloudinary (for cloud storage adapter)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Provider (mock | sendgrid | smtp)
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM=no-reply@realestateplatform.com

# Initial System Administrator (Created on Seed)
ADMIN_EMAIL=admin@realestateplatform.com
ADMIN_PASSWORD=AdminSecurePass@2026
ADMIN_NAME=Platform Administrator

